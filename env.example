# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/brothers_holiday_trekking?schema=public"

# Public canonical URL of the deployed website (used for sitemap, robots, OpenGraph, and cookie security)
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# Secret for signing sessions / HMAC keys (use a strong 64+ char random string in production)
ADMIN_SESSION_SECRET="replace-with-secure-64-character-random-secret"

# 32-byte (64 hex chars) key for AES-256-GCM encryption of TOTP MFA secrets & HMAC backup codes
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_ENCRYPTION_KEY="replace-with-64-hex-character-encryption-key"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Transactional Email (Hostinger SMTP / Nodemailer)
# Leave blank in development to preview verification/reset links in console
# ─────────────────────────────────────────────────────────────────────────────
# SMTP_HOST="smtp.hostinger.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="no-reply@yourdomain.com"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="BROTHERS Holidays Adventure <no-reply@yourdomain.com>"

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Google OAuth 2.0 (Authorization Code + PKCE)
# Callback URL: {NEXT_PUBLIC_SITE_URL}/api/auth/google/callback
# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Cloudflare Turnstile CAPTCHA
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# Optional: Analytics (can also be configured from Admin Site Settings)
# ─────────────────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
# NEXT_PUBLIC_GTM_ID=""
